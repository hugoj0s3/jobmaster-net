<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <VersionPrefix>0.0.3</VersionPrefix>

    <PackageId>JobMaster.Dashboard</PackageId>
    <Authors>Hugo Silva</Authors>
    <Company>Hugo Silva</Company>
    <Copyright>Copyright 2026 Hugo Silva</Copyright>
    <Description>Browser-based dashboard SPA for monitoring and managing JobMaster clusters. Served as embedded static assets from your ASP.NET Core application — no separate deployment required.</Description>
    <PackageProjectUrl>https://github.com/hugoj0s3/jobmaster-net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/hugoj0s3/jobmaster-net</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>background-jobs, distributed-systems, scheduler, dashboard, dotnet, aspnetcore</PackageTags>
    <PackageReadmeFile>JobMaster.Dashboard.NuGet.README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="JobMaster.Dashboard.NuGet.README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.8" />
  </ItemGroup>

  <PropertyGroup>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\dashboard\build\**\*" Exclude="..\dashboard\build\jobmaster-config.json">
      <Link>Embedded\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>
</Project>
