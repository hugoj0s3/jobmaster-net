<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <UserSecretsId>JobMaster.SampleWeb-3e4cc8f0-5b50-4e29-8c15-43e972b0b6ad</UserSecretsId>
        <UseProjectRefs>true</UseProjectRefs>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Faker.Net" Version="2.0.163" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.14"/>
        <PackageReference Include="Serilog" Version="4.2.0" />
        <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
        <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
        <PackageReference Include="Serilog.Sinks.Seq" Version="9.0.0" />
        <PackageReference Include="StackExchange.Redis" Version="2.8.31" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="7.3.1"/>
        <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="7.3.1"/>
        <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="7.3.1"/>
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

    <ItemGroup Condition="'$(UseProjectRefs)' != 'true'">
        <PackageReference Include="JobMaster" Version="$(JobMasterVersion)" />
        <PackageReference Include="JobMaster.Api" Version="$(JobMasterVersion)" />
        <PackageReference Include="JobMaster.MySql" Version="$(JobMasterVersion)" />
        <PackageReference Include="JobMaster.NatsJetStream" Version="$(JobMasterVersion)" />
        <PackageReference Include="JobMaster.Postgres" Version="$(JobMasterVersion)" />
        <PackageReference Include="JobMaster.SqlBase" Version="$(JobMasterVersion)" />
        <PackageReference Include="JobMaster.SqlServer" Version="$(JobMasterVersion)" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseProjectRefs)' == 'true'">
      <ProjectReference Include="..\JobMaster.Api\JobMaster.Api.csproj" />
      <ProjectReference Include="..\JobMaster.NatsJetStream\JobMaster.NatsJetStream.csproj" />
      <ProjectReference Include="..\JobMaster\JobMaster.csproj" />
      <ProjectReference Include="..\Sql\JobMaster.MySql\JobMaster.MySql.csproj" />
      <ProjectReference Include="..\Sql\JobMaster.Postgres\JobMaster.Postgres.csproj" />
      <ProjectReference Include="..\Sql\JobMaster.SqlBase\JobMaster.SqlBase.csproj" />
      <ProjectReference Include="..\Sql\JobMaster.SqlServer\JobMaster.SqlServer.csproj" />
    </ItemGroup>

</Project>
