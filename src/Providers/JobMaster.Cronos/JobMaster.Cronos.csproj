<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>12</LangVersion>
        <PackageId>JobMaster.Cronos</PackageId>

        <!-- New package, versioned independently from the core JobMaster/other Provider packages:
             starts at its own 0.0.1-alpha rather than inheriting JobMaster's current release number. -->
        <VersionPrefix>0.0.1</VersionPrefix>
        <VersionSuffix>alpha</VersionSuffix>

        <Authors>Hugo Silva</Authors>
        <Company>Hugo Silva</Company>
        <Copyright>Copyright 2026 Hugo Silva</Copyright>
        <Description>JobMaster is a framework designed to manage and execute background tasks across a distributed cluster. This package provides Cronos-based standard cron expression support for recurring schedules.</Description>
        <PackageProjectUrl>https://docs.jobmaster.hugoj0s3.dev/</PackageProjectUrl>
        <RepositoryUrl>https://github.com/hugoj0s3/jobmaster-net</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageTags>background-jobs, distributed-systems, scheduler, dotnet, cron</PackageTags>

        <PackageReadmeFile>JobMaster.Cronos.NuGet.README.md</PackageReadmeFile>

        <PublishRepositoryUrl>true</PublishRepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Cronos" Version="0.13.0" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseProjectRefs)' == 'true'">
        <ProjectReference Include="..\..\JobMaster\JobMaster.csproj" />
    </ItemGroup>
    <ItemGroup Condition="'$(UseProjectRefs)' != 'true'">
        <PackageReference Include="JobMaster" Version="$(JobMasterPackageVersion)" />
    </ItemGroup>

    <ItemGroup>
      <None Include="JobMaster.Cronos.NuGet.README.md">
        <Pack>true</Pack>
        <PackagePath>/</PackagePath>
      </None>
    </ItemGroup>

</Project>
