<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net8.0;netstandard2.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>12</LangVersion>
        <PackageId>JobMaster.SqlServer</PackageId>
        <Authors>Hugo Silva</Authors>
        <Company>Hugo Silva</Company>
        <Copyright>Copyright 2026 Hugo Silva</Copyright>
        <Description>JobMaster is a framework designed to manage and execute background tasks across a distributed cluster. This package provides SQL Server integration.</Description>
        <PackageProjectUrl>https://docs.jobmaster.hugoj0s3.dev</PackageProjectUrl>
        <RepositoryUrl>https://github.com/hugoj0s3/jobmaster-net</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageTags>background-jobs, distributed-systems, scheduler, dotnet, job-scheduler, distributed, csharp, cron</PackageTags>

        <PackageReadmeFile>JobMaster.SqlServer.NuGet.README.md</PackageReadmeFile>

        <PublishRepositoryUrl>true</PublishRepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseProjectRefs)' == 'true'">
        <ProjectReference Include="..\JobMaster.SqlBase\JobMaster.SqlBase.csproj" />
    </ItemGroup>
    <ItemGroup Condition="'$(UseProjectRefs)' != 'true'">
        <PackageReference Include="JobMaster.SqlBase" Version="$(JobMasterPackageVersion)" />
    </ItemGroup>

    <ItemGroup>
      <None Include="JobMaster.SqlServer.NuGet.README.md">
        <Pack>true</Pack>
        <PackagePath>/</PackagePath>
      </None>
    </ItemGroup>

    <!-- Security pin: Microsoft.Data.SqlClient pulls a vulnerable System.Security.Cryptography.Pkcs
         (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). Remove once SqlClient depends on a fixed version. -->
    <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
      <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
      <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.22" />
    </ItemGroup>
</Project>
