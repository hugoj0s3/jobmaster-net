<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="StackExchange.Redis" Version="2.8.31" />
        <PackageReference Include="Quartz" Version="3.19.0" />
        <PackageReference Include="Quartz.Extensions.Hosting" Version="3.19.0" />
        <PackageReference Include="Quartz.Serialization.SystemTextJson" Version="3.19.0" />
        <!-- Not referenced directly in code: Quartz's UsePostgres/UseMySqlConnector resolve the
             actual ADO.NET driver at runtime, so the driver assembly must be present in the output
             directory even though no C# code here calls into Npgsql/MySqlConnector types. -->
        <PackageReference Include="Npgsql" Version="8.0.3" />
        <PackageReference Include="MySqlConnector" Version="2.5.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\JobMaster.Benchmarks.Common\JobMaster.Benchmarks.Common.csproj" />
    </ItemGroup>

</Project>
