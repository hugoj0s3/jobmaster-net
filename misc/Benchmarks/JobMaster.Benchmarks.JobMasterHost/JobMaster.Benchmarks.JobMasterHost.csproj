<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="StackExchange.Redis" Version="2.8.31" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\JobMaster.Benchmarks.Common\JobMaster.Benchmarks.Common.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseProjectRefs)' != 'true'">
        <PackageReference Include="JobMaster" Version="$(JobMasterPackageVersion)" />
        <PackageReference Include="JobMaster.SqlBase" Version="0.0.11-alpha" />
        <PackageReference Include="JobMaster.Postgres" Version="0.0.11-alpha" />
        <PackageReference Include="JobMaster.MySql" Version="0.0.11-alpha" />
        <PackageReference Include="JobMaster.SqlServer" Version="0.0.11-alpha" />
        <PackageReference Include="JobMaster.NatsJetStream" Version="0.0.11-alpha" />
        <PackageReference Include="JobMaster.RavenDb" Version="$(JobMasterPackageVersion)" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseProjectRefs)' == 'true'">
        <ProjectReference Include="..\..\..\src\JobMaster\JobMaster.csproj" />
        <ProjectReference Include="..\..\..\src\Providers\JobMaster.SqlBase\JobMaster.SqlBase.csproj" />
        <ProjectReference Include="..\..\..\src\Providers\JobMaster.Postgres\JobMaster.Postgres.csproj" />
        <ProjectReference Include="..\..\..\src\Providers\JobMaster.MySql\JobMaster.MySql.csproj" />
        <ProjectReference Include="..\..\..\src\Providers\JobMaster.SqlServer\JobMaster.SqlServer.csproj" />
        <ProjectReference Include="..\..\..\src\Providers\JobMaster.NatsJetStream\JobMaster.NatsJetStream.csproj" />
        <ProjectReference Include="..\..\..\src\Providers\JobMaster.RavenDb\JobMaster.RavenDb.csproj" />
    </ItemGroup>

</Project>
