<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>12</LangVersion>
        <PackageId>JobMaster.RavenDb</PackageId>
        <Authors>Hugo Silva</Authors>
        <Company>Hugo Silva</Company>
        <Copyright>Copyright 2026 Hugo Silva</Copyright>
        <Description>JobMaster is a framework designed to manage and execute background tasks across a distributed cluster. This package provides RavenDB integration.</Description>
        <PackageProjectUrl>https://docs.jobmaster.hugoj0s3.dev/</PackageProjectUrl>
        <RepositoryUrl>https://github.com/hugoj0s3/jobmaster-net</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageTags>background-jobs, distributed-systems, scheduler, dotnet</PackageTags>
        <PackageReadmeFile>JobMaster.RavenDb.NuGet.README.md</PackageReadmeFile>

        <PublishRepositoryUrl>true</PublishRepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="RavenDB.Client" Version="7.2.5" />
      <None Include="JobMaster.RavenDb.NuGet.README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseProjectRefs)' == 'true'">
        <ProjectReference Include="..\JobMaster\JobMaster.csproj" />
    </ItemGroup>
    <ItemGroup Condition="'$(UseProjectRefs)' != 'true'">
        <PackageReference Include="JobMaster" Version="$(JobMasterPackageVersion)" />
    </ItemGroup>

    <PropertyGroup>
        <DefineConstants>$(DefineConstants);RAVENDB</DefineConstants>
    </PropertyGroup>

</Project>
