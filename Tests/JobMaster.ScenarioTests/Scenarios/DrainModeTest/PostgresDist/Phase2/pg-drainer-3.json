{
  "containerName": "pg-drainer-3",
  "dockerfilePath": "Tests/TargetTestScheduleApp/Dockerfile",
  "networkAlias": "pg-drainer-3",
  "httpPort": 8080,
  "healthCheckPath": "/health",
  "clusterConfigTemplates": [
    {
      "ClusterId": "postgres-drain-load",
      "Default": true,
      "RepoType": "Postgres",
      "ConnectionString": "Host={{PostgresHost}};Port={{PostgresPort}};Database=PostgresDrainLoadCluster;Username={{PostgresUsername}};Password={{PostgresPassword}}",
      "AgentConnections": [
        {
          "Name": "pg-agent-3",
          "RepositoryType": "Postgres",
          "ConnectionString": "Host={{PostgresHost}};Port={{PostgresPort}};Database=PostgresDrainLoadAgent3;Username={{PostgresUsername}};Password={{PostgresPassword}}"
        }
      ],
      "Workers": [
        { "WorkerName": "drainer-3", "AgentConnectionName": "pg-agent-3", "WorkerMode": "Drain" }
      ]
    }
  ]
}
