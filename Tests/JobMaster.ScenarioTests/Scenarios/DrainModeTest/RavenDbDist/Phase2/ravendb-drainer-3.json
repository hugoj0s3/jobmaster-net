{
  "containerName": "ravendb-drainer-3",
  "dockerfilePath": "Tests/TargetTestScheduleApp/Dockerfile",
  "networkAlias": "ravendb-drainer-3",
  "httpPort": 8080,
  "healthCheckPath": "/health",
  "clusterConfigTemplates": [
    {
      "ClusterId": "ravendb-drain-load",
      "Default": true,
      "RepoType": "RavenDB",
      "ConnectionString": "Urls={{RavenDbUrl}};Database=RavendbDrainLoadCluster",
      "AgentConnections": [
        {
          "Name": "raven-agent-3",
          "RepositoryType": "RavenDB",
          "ConnectionString": "Urls={{RavenDbUrl}};Database=RavenDrainAgent3"
        }
      ],
      "Workers": [
        { "WorkerName": "drainer-3", "AgentConnectionName": "raven-agent-3", "WorkerMode": "Drain" }
      ]
    }
  ]
}
