{
  "containerName": "sqlserver-archive",
  "dockerfilePath": "Tests/TargetTestScheduleApp/Dockerfile",
  "networkAlias": "sqlserver-archive",
  "httpPort": 8080,
  "healthCheckPath": "/health",
  "clusterConfigTemplates": [
    {
      "ClusterId": "archive-source",
      "Default": true,
      "RepoType": "SqlServer",
      "ConnectionString": "Server={{SqlServerHost}};Database=ArchiveSource;User Id={{SqlServerUsername}};Password={{SqlServerPassword}};TrustServerCertificate=True;Max Pool Size=300;",
      "DataRetentionTtl": "00:10:00",
      "TargetArchivedClusterId": "archive-target",
      "AgentConnections": [
        {
          "Name": "sqlserver-agent-source",
          "RepositoryType": "SqlServer",
          "ConnectionString": "Server={{SqlServerHost}};Database=ArchiveSourceAgent;User Id={{SqlServerUsername}};Password={{SqlServerPassword}};TrustServerCertificate=True;Max Pool Size=300;"
        }
      ],
      "Workers": [
        { "WorkerName": "coordinator", "WorkerMode": "Coordinator" },
        { "WorkerName": "w1", "AgentConnectionName": "sqlserver-agent-source", "WorkerMode": "Execution" }
      ]
    },
    {
      "ClusterId": "archive-target",
      "Default": false,
      "RepoType": "SqlServer",
      "ConnectionString": "Server={{SqlServerHost}};Database=ArchiveTarget;User Id={{SqlServerUsername}};Password={{SqlServerPassword}};TrustServerCertificate=True;Max Pool Size=300;",
      "Mode": "Archived",
      "Workers": [
        { "WorkerName": "coordinator", "WorkerMode": "Coordinator" }
      ]
    }
  ]
}
