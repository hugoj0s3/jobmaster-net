{
  "containerName": "api",
  "dockerfilePath": "Tests/TargetTestApi/Dockerfile",
  "networkAlias": "api",
  "httpPort": 8080,
  "healthCheckPath": "/health",
  "auth": {
    "requireAuthentication": false
  },
  "clusterConfigTemplates": [
    {
      "ClusterId": "archive-source",
      "Default": true,
      "RepoType": "RavenDB",
      "ConnectionString": "Urls={{RavenDbUrl}};Database=ArchiveSource"
    },
    {
      "ClusterId": "archive-target",
      "Default": false,
      "RepoType": "RavenDB",
      "ConnectionString": "Urls={{RavenDbUrl}};Database=ArchiveTarget"
    }
  ]
}
