{
  "containerName": "api",
  "dockerfilePath": "Tests/TargetTestApi/Dockerfile",
  "networkAlias": "api",
  "httpPort": 8080,
  "healthCheckPath": "/health",
  "auth": {
    "requireAuthentication": true,
    "apiKey": "{{ApiKey}}"
  },
  "clusterConfigTemplates": [
    {
      "ClusterId": "api-key-cluster-one",
      "Default": true,
      "RepoType": "Postgres",
      "ConnectionString": "Host={{PostgresHost}};Port={{PostgresPort}};Database=PostgresStandalone;Username={{PostgresUsername}};Password={{PostgresPassword}}"
    },
    {
      "ClusterId": "api-key-cluster-two",
      "Default": false,
      "RepoType": "Postgres",
      "ConnectionString": "Host={{PostgresHost}};Port={{PostgresPort}};Database=PostgresStandalone;Username={{PostgresUsername}};Password={{PostgresPassword}}"
    }
  ]
}
