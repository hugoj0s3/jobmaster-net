{
  "containerName": "raven-fallback",
  "dockerfilePath": "Tests/TargetTestScheduleApp/Dockerfile",
  "networkAlias": "raven-fallback",
  "httpPort": 8080,
  "healthCheckPath": "/health",
  "clusterConfigTemplates": [
    {
      "ClusterId": "fallback-bucket",
      "Default": true,
      "RepoType": "RavenDB",
      "ConnectionString": "Urls={{RavenDbUrl}};Database=FallbackBucket",
      "Workers": [
        { "WorkerName": "coordinator", "WorkerMode": "Coordinator" }
      ]
    }
  ]
}
