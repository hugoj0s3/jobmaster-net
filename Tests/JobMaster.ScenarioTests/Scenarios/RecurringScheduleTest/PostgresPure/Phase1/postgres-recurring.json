{
  "containerName": "postgres-recurring",
  "dockerfilePath": "Tests/TargetTestRecurringApp/Dockerfile",
  "networkAlias": "postgres-recurring",
  "httpPort": 8080,
  "healthCheckPath": "/health",
  "clusterConfigTemplates": [
    {
      "ClusterId": "postgres-recurring",
      "Standalone": true,
      "SetAsDefault": true,
      "RepoType": "Postgres",
      "ConnectionString": "Host={{PostgresHost}};Port={{PostgresPort}};Database=PostgresRecurring;Username={{PostgresUsername}};Password={{PostgresPassword}}",
      "TransientThreshold": "00:10:00",
      "Workers": [ { "WorkerName": "w1" } ]
    }
  ]
}
