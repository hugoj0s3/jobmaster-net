{
  "containerName": "sqlserver-recurring",
  "dockerfilePath": "Tests/TargetTestRecurringApp/Dockerfile",
  "networkAlias": "sqlserver-recurring",
  "httpPort": 8080,
  "healthCheckPath": "/health",
  "clusterConfigTemplates": [
    {
      "ClusterId": "sqlserver-recurring",
      "Standalone": true,
      "Default": true,
      "RepoType": "SqlServer",
      "ConnectionString": "Server={{SqlServerHost}};Database=SqlServerRecurring;User Id={{SqlServerUsername}};Password={{SqlServerPassword}};TrustServerCertificate=True;Max Pool Size=300;",
      "TransientThreshold": "00:10:00",
      "Workers": [ { "WorkerName": "w1" } ]
    }
  ]
}
