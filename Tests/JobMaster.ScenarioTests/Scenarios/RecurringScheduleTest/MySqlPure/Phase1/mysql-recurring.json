{
  "containerName": "mysql-recurring",
  "dockerfilePath": "Tests/TargetTestRecurringApp/Dockerfile",
  "networkAlias": "mysql-recurring",
  "httpPort": 8080,
  "healthCheckPath": "/health",
  "clusterConfigTemplates": [
    {
      "ClusterId": "mysql-recurring",
      "Standalone": true,
      "Default": true,
      "RepoType": "MySql",
      "ConnectionString": "Server={{MySqlHost}};Port={{MySqlPort}};Database=MySqlRecurring;User ID={{MySqlUsername}};Password={{MySqlPassword}};UseAffectedRows=True;AllowUserVariables=True",
      "TransientThreshold": "00:10:00",
      "Workers": [ { "WorkerName": "w1" } ]
    }
  ]
}
