{
  "containerName": "mysql-executor",
  "dockerfilePath": "Tests/TargetTestScheduleApp/Dockerfile",
  "networkAlias": "mysql-executor",
  "httpPort": 8080,
  "healthCheckPath": "/health",
  "clusterConfigTemplates": [
    {
      "ClusterId": "standalone-to-dist",
      "Default": true,
      "RepoType": "MySql",
      "ConnectionString": "Server={{MySqlHost}};Port={{MySqlPort}};Database=StandaloneToDist;User ID={{MySqlUsername}};Password={{MySqlPassword}};UseAffectedRows=True;AllowUserVariables=True",
      "AgentConnections": [
        {
          "Name": "mysql-agent-dist",
          "RepositoryType": "MySql",
          "ConnectionString": "Server={{MySqlHost}};Port={{MySqlPort}};Database=StandaloneToDistAgent;User ID={{MySqlUsername}};Password={{MySqlPassword}};UseAffectedRows=True;AllowUserVariables=True"
        }
      ],
      "Workers": [
        { "WorkerName": "executor", "AgentConnectionName": "mysql-agent-dist", "WorkerMode": "Execution" }
      ]
    }
  ]
}
