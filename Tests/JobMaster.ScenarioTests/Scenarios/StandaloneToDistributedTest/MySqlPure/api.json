{
  "containerName": "api",
  "dockerfilePath": "Tests/TargetTestApi/Dockerfile",
  "networkAlias": "api",
  "httpPort": 8080,
  "healthCheckPath": "/health",
  "auth": {
    "requireAuthentication": false
  },
  "clusterConfigTemplates": [
    {
      "ClusterId": "standalone-to-dist",
      "Default": true,
      "RepoType": "MySql",
      "ConnectionString": "Server={{MySqlHost}};Port={{MySqlPort}};Database=StandaloneToDist;User ID={{MySqlUsername}};Password={{MySqlPassword}};UseAffectedRows=True;AllowUserVariables=True"
    }
  ]
}
