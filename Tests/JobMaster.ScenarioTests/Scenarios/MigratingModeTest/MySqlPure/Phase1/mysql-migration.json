{
  "containerName": "mysql-migration",
  "dockerfilePath": "Tests/TargetTestScheduleApp/Dockerfile",
  "networkAlias": "mysql-migration",
  "httpPort": 8080,
  "healthCheckPath": "/health",
  "clusterConfigTemplates": [
    {
      "ClusterId": "migrating-source",
      "Default": true,
      "RepoType": "MySql",
      "ConnectionString": "Server={{MySqlHost}};Port={{MySqlPort}};Database=MigratingSource;User ID={{MySqlUsername}};Password={{MySqlPassword}};UseAffectedRows=True;AllowUserVariables=True",
      "Mode": "Migrating",
      "TargetActiveClusterId": "migrating-target",
      "Workers": [
        { "WorkerName": "coordinator", "WorkerMode": "Coordinator" }
      ]
    },
    {
      "ClusterId": "migrating-target",
      "Default": false,
      "RepoType": "MySql",
      "ConnectionString": "Server={{MySqlHost}};Port={{MySqlPort}};Database=MigratingTarget;User ID={{MySqlUsername}};Password={{MySqlPassword}};UseAffectedRows=True;AllowUserVariables=True",
      "AgentConnections": [
        {
          "Name": "mysql-agent-target",
          "RepositoryType": "MySql",
          "ConnectionString": "Server={{MySqlHost}};Port={{MySqlPort}};Database=MigratingTargetAgent;User ID={{MySqlUsername}};Password={{MySqlPassword}};UseAffectedRows=True;AllowUserVariables=True"
        }
      ],
      "Workers": [
        { "WorkerName": "coordinator", "WorkerMode": "Coordinator" },
        { "WorkerName": "w1", "AgentConnectionName": "mysql-agent-target", "WorkerMode": "Execution" }
      ]
    }
  ]
}
