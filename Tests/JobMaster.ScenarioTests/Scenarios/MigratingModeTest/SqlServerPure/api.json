{
  "containerName": "api",
  "dockerfilePath": "Tests/TargetTestApi/Dockerfile",
  "networkAlias": "api",
  "httpPort": 8080,
  "healthCheckPath": "/health",
  "auth": {
    "requireAuthentication": false
  },
  "clusterConfigTemplates": [
    {
      "ClusterId": "migrating-source",
      "Default": true,
      "RepoType": "SqlServer",
      "ConnectionString": "Server={{SqlServerHost}};Database=MigratingSource;User Id={{SqlServerUsername}};Password={{SqlServerPassword}};TrustServerCertificate=True;Max Pool Size=300;"
    },
    {
      "ClusterId": "migrating-target",
      "Default": false,
      "RepoType": "SqlServer",
      "ConnectionString": "Server={{SqlServerHost}};Database=MigratingTarget;User Id={{SqlServerUsername}};Password={{SqlServerPassword}};TrustServerCertificate=True;Max Pool Size=300;"
    }
  ]
}
