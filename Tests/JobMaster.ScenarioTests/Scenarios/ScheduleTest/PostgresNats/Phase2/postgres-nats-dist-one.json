{
  "containerName": "postgres-nats-dist-one",
  "dockerfilePath": "Tests/TargetTestScheduleApp/Dockerfile",
  "networkAlias": "postgres-nats-dist-one",
  "httpPort": 8080,
  "healthCheckPath": "/health",
  "clusterConfigTemplates": [
    {
      "ClusterId": "postgres-nats-dist-one",
      "SetAsDefault": true,
      "RepoType": "Postgres",
      "ConnectionString": "Host={{PostgresHost}};Port={{PostgresPort}};Database=PostgresNatsDistCluster;Username={{PostgresUsername}};Password={{PostgresPassword}}",
      "TransientThreshold": "00:02:00",
      "AgentConnections": [
        {
          "Name": "nats-agent-1",
          "RepositoryType": "NatsJetStream",
          "ConnectionString": "nats://{{NatsUsername}}:{{NatsPassword}}@{{NatsHost}}:{{NatsPort}}"
        },
        {
          "Name": "nats-agent-2",
          "RepositoryType": "NatsJetStream",
          "ConnectionString": "nats://{{NatsUsername}}:{{NatsPassword}}@{{NatsHost}}:{{NatsPort}}"
        },
        {
          "Name": "nats-agent-3",
          "RepositoryType": "NatsJetStream",
          "ConnectionString": "nats://{{NatsUsername}}:{{NatsPassword}}@{{NatsHost}}:{{NatsPort}}"
        }
      ],
      "Workers": [
        { "WorkerName": "coordinator", "WorkerMode": "Coordinator" },
        { "WorkerName": "w1", "AgentConnectionName": "nats-agent-1", "WorkerMode": "Drain" },
        { "WorkerName": "w2", "AgentConnectionName": "nats-agent-2", "WorkerMode": "Drain" },
        { "WorkerName": "w3", "AgentConnectionName": "nats-agent-3", "WorkerMode": "Drain" }
      ]
    }
  ]
}
