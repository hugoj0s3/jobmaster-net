{
  "containerName": "postgres-dist-one",
  "dockerfilePath": "Tests/TargetTestScheduleApp/Dockerfile",
  "networkAlias": "postgres-dist-one",
  "httpPort": 8080,
  "healthCheckPath": "/health",
  "clusterConfigTemplates": [
    {
      "ClusterId": "postgres-dist-one",
      "SetAsDefault": true,
      "RepoType": "Postgres",
      "ConnectionString": "Host={{PostgresHost}};Port={{PostgresPort}};Database=PostgresDistCluster;Username={{PostgresUsername}};Password={{PostgresPassword}}",
      "AgentConnections": [
        {
          "Name": "pg-agent-1",
          "RepositoryType": "Postgres",
          "ConnectionString": "Host={{PostgresHost}};Port={{PostgresPort}};Database=PostgreAgent1;Username={{PostgresUsername}};Password={{PostgresPassword}}"
        },
        {
          "Name": "pg-agent-2",
          "RepositoryType": "Postgres",
          "ConnectionString": "Host={{PostgresHost}};Port={{PostgresPort}};Database=PostgreAgent2;Username={{PostgresUsername}};Password={{PostgresPassword}}"
        },
        {
          "Name": "pg-agent-3",
          "RepositoryType": "Postgres",
          "ConnectionString": "Host={{PostgresHost}};Port={{PostgresPort}};Database=PostgreAgent3;Username={{PostgresUsername}};Password={{PostgresPassword}}"
        }
      ],
      "Workers": [
        { "WorkerName": "coordinator", "WorkerMode": "Coordinator" },
        { "WorkerName": "w1", "AgentConnectionName": "pg-agent-1", "WorkerMode": "Drain" },
        { "WorkerName": "w2", "AgentConnectionName": "pg-agent-2", "WorkerMode": "Drain" },
        { "WorkerName": "w3", "AgentConnectionName": "pg-agent-3", "WorkerMode": "Drain" }
      ]
    }
  ]
}
