{
  "containerName": "ravendb-standalone",
  "dockerfilePath": "Tests/TargetTestScheduleApp/Dockerfile",
  "networkAlias": "ravendb-standalone",
  "httpPort": 8080,
  "healthCheckPath": "/health",
  "clusterConfigTemplates": [
    {
      "ClusterId": "ravendb-standalone",
      "Standalone": true,
      "Default": true,
      "RepoType": "RavenDB",
      "ConnectionString": "Urls={{RavenDbUrl}};Database=RavendbStandalone",
      "DataRetentionTtl": "00:10:00",
      "Workers": [ { "WorkerName": "w1" } ]
    }
  ]
}
