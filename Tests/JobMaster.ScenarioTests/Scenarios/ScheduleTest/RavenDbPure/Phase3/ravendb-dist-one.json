{
  "containerName": "ravendb-dist-one",
  "dockerfilePath": "Tests/TargetTestScheduleApp/Dockerfile",
  "networkAlias": "ravendb-dist-one",
  "httpPort": 8080,
  "healthCheckPath": "/health",
  "clusterConfigTemplates": [
    {
      "ClusterId": "ravendb-dist-one",
      "Default": true,
      "RepoType": "RavenDB",
      "ConnectionString": "Urls={{RavenDbUrl}};Database=RavendbDistCluster",
      "AgentConnections": [
        {
          "Name": "raven-agent-1",
          "RepositoryType": "RavenDB",
          "ConnectionString": "Urls={{RavenDbUrl}};Database=RavenAgent1"
        },
        {
          "Name": "raven-agent-2",
          "RepositoryType": "RavenDB",
          "ConnectionString": "Urls={{RavenDbUrl}};Database=RavenAgent2"
        },
        {
          "Name": "raven-agent-3",
          "RepositoryType": "RavenDB",
          "ConnectionString": "Urls={{RavenDbUrl}};Database=RavenAgent3"
        }
      ],
      "Workers": [
        { "WorkerName": "coordinator", "WorkerMode": "Coordinator" }
      ]
    }
  ]
}
