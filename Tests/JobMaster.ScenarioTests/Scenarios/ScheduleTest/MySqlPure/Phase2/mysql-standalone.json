{
  "containerName": "mysql-standalone",
  "dockerfilePath": "Tests/TargetTestScheduleApp/Dockerfile",
  "networkAlias": "mysql-standalone",
  "httpPort": 8080,
  "healthCheckPath": "/health",
  "clusterConfigTemplates": [
    {
      "ClusterId": "mysql-standalone",
      "Standalone": true,
      "SetAsDefault": true,
      "RepoType": "MySql",
      "ConnectionString": "Server={{MySqlHost}};Port={{MySqlPort}};Database=MySqlStandalone;User ID={{MySqlUsername}};Password={{MySqlPassword}};UseAffectedRows=True;AllowUserVariables=True",
      "DataRetentionTtl": "00:10:00",
      "Workers": [ { "WorkerName": "w1" } ]
    }
  ]
}
