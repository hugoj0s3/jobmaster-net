{
  "containerName": "api",
  "dockerfilePath": "Tests/TargetTestApi/Dockerfile",
  "networkAlias": "api",
  "httpPort": 8080,
  "healthCheckPath": "/health",
  "auth": {
    "requireAuthentication": false
  },
  "clusterConfigTemplates": [
    {
      "ClusterId": "mysql-standalone",
      "Default": true,
      "RepoType": "MySql",
      "ConnectionString": "Server={{MySqlHost}};Port={{MySqlPort}};Database=MySqlStandalone;User ID={{MySqlUsername}};Password={{MySqlPassword}};UseAffectedRows=True;AllowUserVariables=True"
    },
    {
      "ClusterId": "mysql-dist-one",
      "Default": false,
      "RepoType": "MySql",
      "ConnectionString": "Server={{MySqlHost}};Port={{MySqlPort}};Database=MySqlDistCluster;User ID={{MySqlUsername}};Password={{MySqlPassword}};UseAffectedRows=True;AllowUserVariables=True"
    },
    {
      "ClusterId": "mysql-dist-two",
      "Default": false,
      "RepoType": "MySql",
      "ConnectionString": "Server={{MySqlHost}};Port={{MySqlPort}};Database=MySqlDistCluster;User ID={{MySqlUsername}};Password={{MySqlPassword}};UseAffectedRows=True;AllowUserVariables=True"
    }
  ]
}
