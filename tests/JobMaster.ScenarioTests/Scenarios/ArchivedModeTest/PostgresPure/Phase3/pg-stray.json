{
  "containerName": "pg-stray",
  "dockerfilePath": "tests/TargetTestScheduleApp/Dockerfile",
  "networkAlias": "pg-stray",
  "httpPort": 8080,
  "healthCheckPath": "/health",
  "clusterConfigTemplates": [
    {
      "ClusterId": "stray-old",
      "Default": true,
      "RepoType": "Postgres",
      "ConnectionString": "Host={{PostgresHost}};Port={{PostgresPort}};Database=StrayOld;Username={{PostgresUsername}};Password={{PostgresPassword}}",
      "Mode": "Archived",
      "TargetActiveClusterId": "stray-new",
      "Workers": [
        { "WorkerName": "coordinator", "WorkerMode": "Coordinator" }
      ]
    },
    {
      "ClusterId": "stray-new",
      "Default": false,
      "RepoType": "Postgres",
      "ConnectionString": "Host={{PostgresHost}};Port={{PostgresPort}};Database=StrayNew;Username={{PostgresUsername}};Password={{PostgresPassword}}",
      "AgentConnections": [
        {
          "Name": "pg-agent-stray-new",
          "RepositoryType": "Postgres",
          "ConnectionString": "Host={{PostgresHost}};Port={{PostgresPort}};Database=StrayNewAgent;Username={{PostgresUsername}};Password={{PostgresPassword}}"
        }
      ],
      "Workers": [
        { "WorkerName": "coordinator", "WorkerMode": "Coordinator" },
        { "WorkerName": "w1", "AgentConnectionName": "pg-agent-stray-new", "WorkerMode": "Execution" }
      ]
    }
  ]
}
