{
  "containerName": "mx-{{flavor}}-{{stop}}-drain-drainer-3",
  "dockerfilePath": "tests/TargetTestScheduleApp/Dockerfile",
  "networkAlias": "mx-{{flavor}}-{{stop}}-drain-drainer-3",
  "httpPort": 8080,
  "healthCheckPath": "/health",
  "clusterConfigTemplates": [
    {
      "ClusterId": "mx-{{flavor}}-{{stop}}-drain",
      "Default": true,
      "RepoType": "{{master:RepoType}}",
      "ConnectionString": "{{master:ConnectionString:Drain{{stop}}}}",
      "TransientThreshold": "00:05:00",
      "AgentConnections": [
        { "Name": "agent-3", "Connection": "{{agent:3}}" }
      ],
      "Workers": [
        { "WorkerName": "drainer-3", "AgentConnectionName": "agent-3", "WorkerMode": "Drain" }
      ]
    }
  ]
}
