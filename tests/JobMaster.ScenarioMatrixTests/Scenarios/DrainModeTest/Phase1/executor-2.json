{
  "containerName": "mx-{{flavor}}-{{stop}}-drain-executor-2",
  "dockerfilePath": "tests/TargetTestScheduleApp/Dockerfile",
  "networkAlias": "mx-{{flavor}}-{{stop}}-drain-executor-2",
  "httpPort": 8080,
  "healthCheckPath": "/health",
  "clusterConfigTemplates": [
    {
      "ClusterId": "mx-{{flavor}}-{{stop}}-drain",
      "Default": true,
      "RepoType": "{{master:RepoType}}",
      "ConnectionString": "{{master:ConnectionString:Drain{{stop}}}}",
      "TransientThreshold": "00:05:00",
      "AgentConnections": [
        { "Name": "agent-2", "Connection": "{{agent:2}}" }
      ],
      "Workers": [
        { "WorkerName": "executor-2", "AgentConnectionName": "agent-2", "WorkerMode": "Execution", "ParallelismFactor": 4.0 }
      ]
    }
  ]
}
