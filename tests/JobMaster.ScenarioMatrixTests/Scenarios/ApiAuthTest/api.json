{
  "containerName": "api",
  "dockerfilePath": "tests/TargetTestApi/Dockerfile",
  "networkAlias": "api",
  "httpPort": 8080,
  "healthCheckPath": "/health",
  "auth": "{{authConfig}}",
  "clusterConfigTemplates": [
    {
      "ClusterId": "mx-{{flavor}}-{{auth}}-one",
      "Default": true,
      "RepoType": "{{master:RepoType}}",
      "ConnectionString": "{{master:ConnectionString:ApiAuth{{auth}}}}"
    },
    {
      "ClusterId": "mx-{{flavor}}-{{auth}}-two",
      "Default": false,
      "RepoType": "{{master:RepoType}}",
      "ConnectionString": "{{master:ConnectionString:ApiAuth{{auth}}}}"
    }
  ]
}
