<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Runs the JobMaster.UnitTests test files against the netstandard2.0 build of every library (on the .NET 8
      runtime), so the NETSTANDARD2_0 code paths are tested too. A .NET 8 test project would otherwise always load
      the net8.0 builds. Api / Dashboard have no netstandard2.0 build, so their tests aren't included here.
    -->

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <UseProjectRefs>true</UseProjectRefs>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\JobMaster.UnitTests\**\*.cs"
                 Exclude="..\JobMaster.UnitTests\bin\**;..\JobMaster.UnitTests\obj\**;..\JobMaster.UnitTests\Api\**;..\JobMaster.UnitTests\Dashboard\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FluentAssertions" Version="8.8.0" />
        <PackageReference Include="Moq" Version="4.20.72" />
        <!-- JobMaster.UnitTests gets it through the ASP.NET Core framework reference (needed for its Api tests). -->
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.2" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.6.0"/>
        <PackageReference Include="xunit" Version="2.4.2"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="coverlet.collector" Version="6.0.0">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\JobMaster\JobMaster.csproj" SetTargetFramework="TargetFramework=netstandard2.0" />
      <ProjectReference Include="..\..\src\StorageProviders\JobMaster.NatsJetStream\JobMaster.NatsJetStream.csproj" SetTargetFramework="TargetFramework=netstandard2.0" />
      <ProjectReference Include="..\..\src\StorageProviders\JobMaster.RavenDB\JobMaster.RavenDB.csproj" SetTargetFramework="TargetFramework=netstandard2.0" />
      <ProjectReference Include="..\..\src\StorageProviders\JobMaster.SqlBase\JobMaster.SqlBase.csproj" SetTargetFramework="TargetFramework=netstandard2.0" />
      <ProjectReference Include="..\..\src\StorageProviders\JobMaster.Postgres\JobMaster.Postgres.csproj" SetTargetFramework="TargetFramework=netstandard2.0" />
      <ProjectReference Include="..\..\src\StorageProviders\JobMaster.MySql\JobMaster.MySql.csproj" SetTargetFramework="TargetFramework=netstandard2.0" />
      <ProjectReference Include="..\..\src\StorageProviders\JobMaster.SqlServer\JobMaster.SqlServer.csproj" SetTargetFramework="TargetFramework=netstandard2.0" />
      <ProjectReference Include="..\..\src\RecurrenceProviders\JobMaster.Cronos\JobMaster.Cronos.csproj" SetTargetFramework="TargetFramework=netstandard2.0" />
      <ProjectReference Include="..\..\src\RecurrenceProviders\JobMaster.NCrontab\JobMaster.NCrontab.csproj" SetTargetFramework="TargetFramework=netstandard2.0" />
    </ItemGroup>

</Project>
